# ─────────────────────────────────────────────────────────────────────────────
# WC — WhatsApp AI Chatbot
# Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886   # Twilio sandbox number

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini        # or gpt-4o for higher quality
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=600

# ── Embedding (Knowledge Base) ────────────────────────────────────────────────
EMBEDDING_PROVIDER=openai       # openai | ollama
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
OLLAMA_URL=http://localhost:11434   # only needed if EMBEDDING_PROVIDER=ollama

# ── Vector Store (Pinecone — free tier, works on Vercel) ─────────────────────
PINECONE_API_KEY=your_pinecone_api_key   # from https://app.pinecone.io
PINECONE_INDEX=wc-kb                     # index name (created automatically on first run)
CHUNK_SIZE=512                  # words per chunk
CHUNK_OVERLAP=50                # overlap words between chunks

# ── Retrieval ─────────────────────────────────────────────────────────────────
SCORE_THRESHOLD=0.3             # minimum similarity score for KB results
CACHE_THRESHOLD=0.92            # minimum similarity score for semantic cache hits
TOP_K=4                         # number of KB chunks to retrieve

# ── Admin API ─────────────────────────────────────────────────────────────────
ADMIN_API_KEY=                  # leave empty to disable auth (not recommended for prod)

# ── Karisma RAG (optional fallback if internal KB is empty) ──────────────────
KARISMA_URL=                    # leave empty to disable external Karisma fallback
KARISMA_TOKEN=

# ── Default Tenant ────────────────────────────────────────────────────────────
DEFAULT_TENANT_ID=demo
DEFAULT_CATEGORY=general
BUSINESS_NAME=My Business

# ── Redis (optional — falls back to in-memory if not available) ───────────────
REDIS_URL=redis://localhost:6379
SESSION_TTL_SECONDS=1800        # 30 minutes

# ── M-Pesa Daraja ─────────────────────────────────────────────────────────────
MPESA_DARAJA_URL=https://sandbox.safaricom.co.ke   # change to https://api.safaricom.co.ke for production
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379           # sandbox shortcode
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CALLBACK_URL=https://your-public-url.com/mpesa/callback
MPESA_ACCOUNT_REF=WC

# ── Demo Mode ─────────────────────────────────────────────────────────────────
DEMO_NUMBERS=                   # comma-separated WhatsApp numbers in demo mode
DEMO_BUSINESS_NAME=WC AI Demo
DEMO_CATEGORY=general
CONTACT_EMAIL=hello@yoursite.com
